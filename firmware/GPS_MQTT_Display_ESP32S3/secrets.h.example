// ── MQTT Broker (Mosquitto, LAN, authenticated, no TLS) ─────────────────────
// This display subscribes (reads) sensors/gps-tracker/# — it does NOT need
// the same "gps-tracker" credentials the GPS_MQTT_Diagnostic_ESP32C3
// publisher uses. Provision a separate, read-only user for it, e.g.
// "gps-display", scoped to sensors/gps-tracker/#.
#define MQTT_HOST      "YOUR_MQTT_HOST"
#define MQTT_PORT      1883
#define MQTT_USER      "YOUR_MQTT_USER"
#define MQTT_PASSWORD  "YOUR_MQTT_PASSWORD"
